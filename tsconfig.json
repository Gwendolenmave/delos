{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "outDir": "build",
    "rootDir": ".",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["core/**/*.ts", "adapters/**/*.ts", "composition/**/*.ts", "surfaces/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "build", "data"]
}
